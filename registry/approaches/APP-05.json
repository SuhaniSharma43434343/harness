{
  "id": "APP-05",
  "name": "Shader / WebGL Website",
  "summary": "A custom GLSL background or transition effect with a quality ladder (full, reduced, off). Picked by default at motion intensity 2 or 3, or when the brief asks for a shader background.",
  "registryVersion": "0.1.0",
  "verification": "implemented",
  "module": {
    "skill": "skills/app05/SKILL.md",
    "recipes": [
      "skills/app05/recipes/lib/shader.js",
      "skills/app05/recipes/lib/webgl-slot.js",
      "skills/app05/recipes/sections/ShaderBackground.astro"
    ]
  },
  "selectWhen": {
    "any": [
      {
        "field": "features.interactive",
        "op": "includes",
        "value": "shader-background"
      },
      {
        "field": "brand.motionIntensity",
        "op": "gte",
        "value": 2
      }
    ]
  },
  "rejectWhen": {
    "field": "brand.motionIntensity",
    "op": "eq",
    "value": 0
  },
  "fallback": {
    "approach": "APP-01",
    "description": "CSS gradient or a static frame",
    "triggers": [
      "reduced-motion",
      "no-webgl",
      "low-end-device",
      "load-failed",
      "slow-network"
    ]
  },
  "budget": {
    "gpuMsPerFrame": 8,
    "extraJsKbGzip": 80
  },
  "dependencies": [
    {
      "name": "own GLSL shaders",
      "licence": "harness (own work)",
      "licenceVerified": true,
      "note": "Plain WebGL with our own value noise; no library and no third-party noise functions"
    }
  ],
  "tests": {
    "positiveBriefs": [
      "tests/decision/app05/pos-1.json",
      "tests/decision/app05/pos-2.json",
      "tests/decision/app05/pos-3.json"
    ],
    "negativeBriefs": [
      "tests/decision/app05/neg-1.json",
      "tests/decision/app05/neg-2.json",
      "tests/decision/app05/neg-3.json"
    ],
    "build": "tests/build/app05.test.mjs",
    "fallback": "tests/build/app05.test.mjs",
    "budget": "tests/build/app05.test.mjs"
  }
}
