{
  "id": "APP-08",
  "name": "AI Image to Frame Animation to 3D",
  "summary": "A scroll-scrubbed frame sequence from owned or licensed frames, plus a 2.5D depth-map parallax scene from a supplied or generated depth map. For a parallax or scrubbed hero sequence.",
  "registryVersion": "0.1.0",
  "verification": "implemented",
  "module": {
    "skill": "skills/app08/SKILL.md",
    "recipes": [
      "skills/app08/recipes/lib/frames.js",
      "skills/app08/recipes/sections/DepthParallax.astro",
      "skills/app08/recipes/sections/FrameSequence.astro"
    ]
  },
  "selectWhen": {
    "field": "features.interactive",
    "op": "includes",
    "value": "frame-sequence"
  },
  "rejectWhen": {
    "any": [
      {
        "field": "brand.motionIntensity",
        "op": "eq",
        "value": 0
      },
      {
        "field": "constraints.deviceFloor",
        "op": "eq",
        "value": "low"
      }
    ]
  },
  "fallback": {
    "approach": "APP-01",
    "description": "A static key frame",
    "triggers": [
      "reduced-motion",
      "no-webgl",
      "low-end-device",
      "load-failed",
      "slow-network"
    ]
  },
  "budget": {
    "assetsMb": 3
  },
  "dependencies": [
    {
      "name": "ffmpeg",
      "licence": "LGPL-2.1 or GPL, by build",
      "licenceVerified": false,
      "note": "System tool, not shipped; only needed to turn a video into frames"
    },
    {
      "name": "frames and depth maps",
      "licence": "per frame",
      "licenceVerified": false,
      "note": "Every frame and depth map needs a provenance row (registerFrames); generated frames record the generator's terms"
    }
  ],
  "tests": {
    "positiveBriefs": [
      "tests/decision/app08/pos-1.json",
      "tests/decision/app08/pos-2.json",
      "tests/decision/app08/pos-3.json"
    ],
    "negativeBriefs": [
      "tests/decision/app08/neg-1.json",
      "tests/decision/app08/neg-2.json",
      "tests/decision/app08/neg-3.json"
    ],
    "build": "tests/build/app08.test.mjs",
    "fallback": "tests/build/app08.test.mjs",
    "budget": "tests/build/app08.test.mjs"
  }
}
