{
  "id": "APP-02",
  "name": "Cinematic Scroll Website",
  "summary": "Pinned sections, scroll-scrubbed reveals and section transitions with synced smooth scroll. Picked by default at motion intensity 2 or 3, and for launches, flagships and premium sites.",
  "registryVersion": "0.1.0",
  "verification": "implemented",
  "module": {
    "skill": "skills/app02/SKILL.md",
    "recipes": [
      "skills/app02/recipes/sections/ScrollStory.astro",
      "skills/app02/recipes/sections/Chapter.astro",
      "skills/app02/recipes/lib/cinematic.js",
      "skills/app02/recipes/lib/app02.css"
    ]
  },
  "selectWhen": {
    "any": [
      {
        "field": "projectType",
        "op": "in",
        "value": [
          "launch",
          "flagship"
        ]
      },
      {
        "field": "features.interactive",
        "op": "includes",
        "value": "scroll-story"
      },
      {
        "field": "brand.tone",
        "op": "includes",
        "value": "premium"
      },
      {
        "field": "brand.motionIntensity",
        "op": "gte",
        "value": 2
      }
    ]
  },
  "rejectWhen": {
    "field": "brand.motionIntensity",
    "op": "lte",
    "value": 1
  },
  "fallback": {
    "approach": "APP-01",
    "description": "Static stacked layout with CSS reveals",
    "triggers": [
      "reduced-motion",
      "low-end-device",
      "load-failed",
      "slow-network"
    ]
  },
  "budget": {
    "extraJsKbGzip": 60,
    "cls": 0.1
  },
  "dependencies": [
    {
      "name": "gsap",
      "licence": "GSAP Standard 'no charge' licence",
      "licenceVerified": false,
      "note": "Own licence, not open source: confirm the terms allow client sites before release. Pinned at 3.15.0 by the APP-02 module."
    },
    {
      "name": "gsap/ScrollTrigger",
      "licence": "GSAP Standard 'no charge' licence",
      "licenceVerified": false,
      "note": "Ships with gsap"
    },
    {
      "name": "lenis",
      "licence": "MIT",
      "licenceVerified": true,
      "note": "MIT as listed on npm (2026-10-28). Pinned at 1.3.27 by the APP-02 module."
    }
  ],
  "tests": {
    "positiveBriefs": [
      "tests/decision/app02/pos-1.json",
      "tests/decision/app02/pos-2.json",
      "tests/decision/app02/pos-3.json"
    ],
    "negativeBriefs": [
      "tests/decision/app02/neg-1.json",
      "tests/decision/app02/neg-2.json",
      "tests/decision/app02/neg-3.json"
    ],
    "build": "tests/build/app02.test.mjs",
    "fallback": "tests/build/app02.test.mjs",
    "budget": "tests/build/app02.test.mjs"
  }
}
