---
// A placeholder picture drawn from the theme tokens: arches and circles placed from a seed, so
// each slot looks different but every one is the harness's own work. It stands in for a client
// photo until Asset Rights records a real one; pass `label` for the screen-reader text.
// Props: seed (any string), label, ratio ("4/3" by default), variant ("hero" | "tile" | "icon").
const { seed = 'forge', label, ratio = '4/3', variant = 'tile' } = Astro.props;

let h = 2166136261;
for (const c of String(seed)) h = Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0;
const rand = () => ((h = Math.imul(h ^ (h >>> 15), 2246822507) >>> 0), (h % 1000) / 1000);
const fills = ['var(--color-primary)', 'var(--color-accent)', 'var(--color-muted)', 'var(--color-border)'];
const shapes = Array.from({ length: variant === 'icon' ? 2 : 4 }, (_, i) => ({
  kind: rand() > 0.45 ? 'arch' : 'circle',
  x: 8 + rand() * 62,
  y: 18 + rand() * 40,
  r: (variant === 'icon' ? 26 : 16) + rand() * 18,
  fill: fills[(i + Math.floor(rand() * 4)) % fills.length],
  opacity: 0.55 + rand() * 0.45,
}));
---
<div class={`art art--${variant}`} style={`aspect-ratio:${ratio}`} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} data-placeholder="art">
  <svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" focusable="false">
    <rect width="100" height="100" fill="var(--color-surface)" />
    <rect y="74" width="100" height="26" fill="var(--color-border)" opacity="0.6" />
    {shapes.map((s) =>
      s.kind === 'arch' ? (
        <path d={`M${s.x} ${s.y + s.r * 1.6}V${s.y + s.r * 0.6}a${s.r * 0.6} ${s.r * 0.6} 0 0 1 ${s.r * 1.2} 0V${s.y + s.r * 1.6}Z`} fill={s.fill} opacity={s.opacity} />
      ) : (
        <circle cx={s.x + s.r / 2} cy={s.y} r={s.r / 2} fill={s.fill} opacity={s.opacity} />
      ),
    )}
  </svg>
</div>
<style>
  .art { position: relative; overflow: hidden; border-radius: var(--radius); background: var(--color-surface); }
  .art svg { display: block; width: 100%; height: 100%; }
  .art--hero { border-radius: calc(var(--radius) * 3); box-shadow: 0 1.5rem 3rem -1.5rem color-mix(in srgb, var(--color-fg) 35%, transparent); }
  .art--icon { width: 3.25rem; border-radius: 50%; }
</style>
