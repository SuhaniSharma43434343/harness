---
// Renders a page's sections in order. `use: "APP-0N/Name"` resolves to
// src/sections/APP-0N/Name.astro; an unknown section fails the build instead of rendering nothing.
// This imports every section, so a page rendered through it carries every section's CSS. The build
// avoids that: scripts/sync-content.mjs writes a route per page that imports only its own sections
// (see SectionList.astro), and only pages without one fall back to this.
import SectionList from './SectionList.astro';

const modules = import.meta.glob('../sections/*/*.astro', { eager: true });
const components = Object.fromEntries(
  Object.entries(modules).map(([path, mod]) => [path.replace('../sections/', '').replace(/\.astro$/, ''), mod.default]),
);

const { page, Content } = Astro.props;
---
<SectionList page={page} Content={Content} components={components} />
