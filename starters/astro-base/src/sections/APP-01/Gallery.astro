---
// A grid of pictures. Props: heading, lead, images: [{ src, alt, width, height, caption? }],
// slots (how many token-coloured placeholders to show while there are no images; default 6).
import Art from '../../components/Art.astro';
const { page, heading, lead, images = [], slots = 6, index = 0 } = Astro.props;
const placeholders = images.length ? [] : Array.from({ length: slots }, (_, i) => `${page.id}-${index}-${i}`);
---
{(images.length > 0 || placeholders.length > 0) && (
  <section class="section section--alt">
    <div class="wrap">
      {heading && <h2>{heading}</h2>}
      {lead && <p class="lead">{lead}</p>}
      <ul class="gallery">
        {images.map((img) => (
          <li><figure><img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" />{img.caption && <figcaption>{img.caption}</figcaption>}</figure></li>
        ))}
        {placeholders.map((seed, i) => (
          <li class={i % 5 === 0 ? 'gallery__wide' : undefined}><Art seed={seed} ratio={i % 5 === 0 ? '2/1' : '1/1'} label="Placeholder picture: a client photo goes here" /></li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr)); gap: var(--space); margin: calc(var(--space) * 2) 0 0; padding: 0; list-style: none; }
  .gallery__wide { grid-column: span 2; }
  @media (max-width: 34rem) { .gallery__wide { grid-column: auto; } }
  .gallery figure { margin: 0; }
  .gallery img { width: 100%; height: auto; border-radius: var(--radius); object-fit: cover; }
  .gallery figcaption { margin-top: 0.4em; color: var(--color-muted); font-size: var(--step-n1); }
</style>
