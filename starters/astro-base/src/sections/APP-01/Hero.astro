---
// The page heading, beside a picture. Props: heading (defaults to the page title), lead, cta
// ({ label, href }, defaults to the page's call to action; false hides it), eyebrow, image
// ({ src, alt, width, height }; without one a token-coloured placeholder stands in), art: false
// for a text-only hero, layout: "cover" to run the image full width behind the copy.
import Art from '../../components/Art.astro';
const { page, heading = page.data.title, lead, cta = page.data.cta, eyebrow, image, art = true, layout = 'split' } = Astro.props;
const cover = layout === 'cover' && image;
---
{cover ? (
<section class="hero hero--cover">
  <img class="hero__bg" src={image.src} alt={image.alt ?? ''} width={image.width} height={image.height} fetchpriority="high" />
  <div class="wrap hero__copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{heading}</h1>
    {lead && <p class="lead">{lead}</p>}
    {cta && <a class="button button--accent" href={cta.href}>{cta.label}</a>}
  </div>
</section>
) : (
<section class={`section hero${art ? ' hero--split' : ''}`}>
  <div class="wrap hero__grid">
    <div class="hero__copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{heading}</h1>
      {lead && <p class="lead">{lead}</p>}
      {cta && <a class="button" href={cta.href}>{cta.label}</a>}
    </div>
    {art && (image
      ? <img class="hero__image" src={image.src} alt={image.alt} width={image.width} height={image.height} />
      : <Art seed={page.id} variant="hero" ratio="5/4" />)}
  </div>
</section>
)}
<style>
  .hero { padding-block: calc(var(--space) * 5); background: linear-gradient(180deg, var(--color-surface), var(--color-bg)); }
  .hero h1 { font-size: clamp(2.4rem, 5vw + 1rem, 4.5rem); line-height: 1.05; margin-block: 0.2em 0.35em; }
  .hero .button { margin-top: var(--space); }
  .hero__grid { display: grid; gap: calc(var(--space) * 3); align-items: center; }
  .hero--split .hero__grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .hero__image { width: 100%; height: auto; border-radius: calc(var(--radius) * 3); object-fit: cover; }
  .eyebrow { margin: 0; text-transform: uppercase; letter-spacing: 0.12em; font-size: var(--step-n1); font-weight: 700; color: var(--color-accent); }
  .hero--cover { position: relative; isolation: isolate; display: grid; align-items: end; min-height: min(88vh, 52rem); padding-block: calc(var(--space) * 6) calc(var(--space) * 4); color: #fff; overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .hero--cover::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(0 0 0 / 0.15) 0%, rgb(0 0 0 / 0.35) 45%, rgb(0 0 0 / 0.78) 100%); }
  .hero--cover .lead { color: rgb(255 255 255 / 0.9); max-width: 40rem; }
  .hero--cover .eyebrow { color: #fff; opacity: 0.9; }
  .hero--cover h1 { max-width: 16ch; }
</style>
