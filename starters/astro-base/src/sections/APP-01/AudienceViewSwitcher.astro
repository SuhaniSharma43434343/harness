---
// Segmented paths for different visitors (an x-factor tool), e.g. Residential and Commercial.
// Props: heading, intro, label (the tab list's name; defaults to the heading), views
// ([{ label, heading, text, points, cta: { label, href } }]; a view without a cta links to the
// page's). It is an ARIA tabs widget: arrow keys move between the views, Home and End jump to
// the first and last, and each view ends on a link to its own path. Without JavaScript
// (`scripting: none`) the tabs hide and every view shows, one after another.
const { page, heading, intro, label, views = [], index = 0 } = Astro.props;
const id = `views-${index}`;
---
{views.length > 0 && (
  <section class="section views" aria-labelledby={heading ? `${id}-title` : undefined}>
    <div class="wrap">
      {heading && <h2 id={`${id}-title`}>{heading}</h2>}
      {intro && <p class="lead">{intro}</p>}
      <div class="views__tabs" role="tablist" aria-label={label ?? heading ?? 'Choose your path'} data-views>
        {views.map((view, i) => (
          <button
            type="button"
            role="tab"
            id={`${id}-tab-${i}`}
            aria-controls={`${id}-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >{view.label}</button>
        ))}
      </div>
      {views.map((view, i) => {
        const cta = view.cta ?? page.data.cta;
        return (
          <div class="views__panel" role="tabpanel" id={`${id}-panel-${i}`} aria-labelledby={`${id}-tab-${i}`} hidden={i !== 0}>
            <h3>{view.heading ?? view.label}</h3>
            {view.text && <p>{view.text}</p>}
            {view.points?.length > 0 && <ul class="views__points">{view.points.map((p) => <li>{p}</li>)}</ul>}
            <a class="button" href={cta.href}>{cta.label}</a>
          </div>
        );
      })}
    </div>
  </section>
)}
<style>
  .views__tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    max-width: 100%;
    margin-block: var(--space) calc(var(--space) * 1.5);
    padding: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) * 2);
    background: var(--color-surface);
  }
  .views__tabs [role='tab'] {
    min-height: 44px;
    min-width: 44px;
    padding: 0.5em 1.25em;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-fg);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: background-color var(--motion-duration) ease-out, color var(--motion-duration) ease-out;
  }
  .views__tabs [role='tab']:hover { background: var(--color-bg); }
  .views__tabs [role='tab']:active { transform: scale(0.98); }
  .views__tabs [role='tab'][aria-selected='true'] { background: var(--color-primary); color: var(--color-on-primary); }
  .views__tabs [role='tab']:focus-visible { outline-offset: 3px; }
  .views__panel {
    max-width: 48rem;
    padding: calc(var(--space) * 1.5);
    border-inline-start: 4px solid var(--color-primary);
  }
  /* Only a switch animates; the first view is simply there on load. */
  [data-switched] ~ .views__panel { animation: views-in var(--motion-duration) ease-out; }
  .views__points { display: grid; gap: 0.35em; margin: 0 0 calc(var(--space) * 1.25); padding-inline-start: 1.25em; }
  @keyframes views-in {
    from { opacity: 0; transform: translateY(var(--motion-distance)); }
  }
  @media (scripting: none) {
    .views__tabs { display: none; }
    .views__panel[hidden] { display: block; }
    .views__panel + .views__panel { margin-top: calc(var(--space) * 1.5); }
  }
</style>

<script>
  // ARIA tabs with automatic activation: click, arrow keys, Home and End select a view.
  for (const list of document.querySelectorAll<HTMLElement>('[data-views]')) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      list.dataset.switched = '';
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      }
    };
    list.addEventListener('click', (e) => {
      const tab = (e.target as Element).closest<HTMLButtonElement>('[role="tab"]');
      if (tab) select(tab);
    });
    list.addEventListener('keydown', (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      const n = tabs.length;
      const to = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: n - 1 }[e.key];
      if (i < 0 || to === undefined) return;
      e.preventDefault();
      const tab = tabs[(to + n) % n];
      tab.focus();
      select(tab);
    });
  }
</script>
