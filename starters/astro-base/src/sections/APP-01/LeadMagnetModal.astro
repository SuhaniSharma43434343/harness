---
// A lead magnet (an x-factor tool): a button opens a native modal <dialog> with a short form.
// Props: form (the form id, default "lead-magnet"), heading, text, button (the opener's label),
// title and intro (the dialog's heading and text; default to heading and text), submitLabel,
// success (the thank-you message), privacy (a line under the form).
// The form posts to the site's form contract: the form's `action` in src/site.json when the
// form plugin has set one, otherwise /api/form?form=<id> (the form plugin's endpoint). Its
// fields come from site.json `forms.<id>` when the form is defined there, otherwise name and
// email. The opener uses the native invoker commands (commandfor/command), so the dialog opens
// without JavaScript in current browsers; the script covers older ones, returns focus to the
// opener on close and sends the form without leaving the page. Escape closes it natively.
import site from '../../site.json';

const {
  form: formId = 'lead-magnet',
  heading,
  text,
  button = 'Get it free',
  title = heading ?? button,
  intro = text,
  submitLabel = 'Send it to me',
  success = 'Thank you. It is on its way to your inbox.',
  privacy,
  index = 0,
} = Astro.props;
const config = site.forms?.[formId];
const action = config?.action ?? `/api/form?form=${encodeURIComponent(formId)}`;
const fields = config?.fields ?? [
  { name: 'name', label: 'Name', type: 'text', required: true, autocomplete: 'name' },
  { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' },
];
const id = `magnet-${index}`;
---
<section class="section magnet" aria-labelledby={heading ? `${id}-heading` : undefined}>
  <div class="wrap magnet__band">
    <div>
      {heading && <h2 id={`${id}-heading`}>{heading}</h2>}
      {text && <p>{text}</p>}
    </div>
    <button
      type="button"
      class="button magnet__open"
      aria-haspopup="dialog"
      aria-controls={id}
      commandfor={id}
      command="show-modal"
      data-dialog-open
    >{button}</button>
  </div>
  <dialog class="magnet__dialog" id={id} aria-labelledby={`${id}-title`} closedby="any">
    <div class="magnet__head">
      <h2 id={`${id}-title`}>{title}</h2>
      <button type="button" class="magnet__close" commandfor={id} command="close">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
        <span class="magnet__sr">Close</span>
      </button>
    </div>
    {intro && <p>{intro}</p>}
    <form class="form" method="post" action={action} data-magnet-form data-success={success} aria-labelledby={`${id}-title`}>
      {fields.map((f) => (
        <div class="field">
          <label for={`${id}-${f.name}`}>{f.label}{f.required ? '' : ' (optional)'}</label>
          {f.type === 'textarea' ? (
            <textarea id={`${id}-${f.name}`} name={f.name} required={f.required} autocomplete={f.autocomplete} />
          ) : (
            <input id={`${id}-${f.name}`} name={f.name} type={f.type} required={f.required} autocomplete={f.autocomplete} />
          )}
        </div>
      ))}
      <div><button class="button" type="submit">{submitLabel}</button></div>
      {privacy && <p class="magnet__privacy">{privacy}</p>}
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </dialog>
</section>
<style>
  .magnet__band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--space) * 1.5);
    padding: calc(var(--space) * 2);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) * 2);
  }
  .magnet__band p { margin-bottom: 0; }
  .magnet__open:active, .magnet__dialog .button:active { transform: translateY(0) scale(0.98); }
  .magnet__dialog {
    width: min(100% - 2 * var(--space), 34rem);
    max-height: calc(100dvh - 2 * var(--space));
    padding: calc(var(--space) * 1.5);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) * 2);
    background: var(--color-bg);
    color: var(--color-fg);
    opacity: 1;
    translate: 0 0;
    transition: opacity var(--motion-duration) ease-out, translate var(--motion-duration) ease-out, overlay var(--motion-duration) allow-discrete, display var(--motion-duration) allow-discrete;
  }
  .magnet__dialog:not([open]) { opacity: 0; translate: 0 var(--motion-distance); }
  @starting-style {
    .magnet__dialog[open] { opacity: 0; translate: 0 var(--motion-distance); }
  }
  .magnet__dialog::backdrop { background: color-mix(in srgb, var(--color-fg) 60%, transparent); }
  .magnet__head { display: flex; align-items: start; justify-content: space-between; gap: var(--space); }
  .magnet__head h2 { font-size: var(--step-2); }
  .magnet__close {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: -0.5rem -0.5rem 0 0;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-fg);
    cursor: pointer;
    transition: background-color var(--motion-duration) ease-out, border-color var(--motion-duration) ease-out;
  }
  .magnet__close:hover { background: var(--color-surface); border-color: var(--color-border); }
  .magnet__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .magnet__privacy { font-size: var(--step-n1); color: var(--color-muted); margin: 0; }
  :global(html:has(.magnet__dialog[open])) { overflow: hidden; }
</style>

<script>
  // Opens and closes each lead-magnet dialog where invoker commands are missing, returns focus to
  // the opener on close, and sends the form in place.
  const native = 'command' in HTMLButtonElement.prototype;
  for (const opener of document.querySelectorAll<HTMLButtonElement>('[data-dialog-open][commandfor]')) {
    const dialog = document.getElementById(opener.getAttribute('commandfor')!) as HTMLDialogElement;
    if (!native) {
      opener.addEventListener('click', () => dialog.open || dialog.showModal());
      dialog.querySelector('[command="close"]')?.addEventListener('click', () => dialog.close());
    }
    dialog.addEventListener('close', () => opener.focus());
    // Start on the first field rather than the close button.
    dialog.addEventListener('toggle', (e) => (e as ToggleEvent).newState === 'open' && form.querySelector<HTMLElement>('input, textarea')?.focus());

    const form = dialog.querySelector<HTMLFormElement>('form[data-magnet-form]')!;
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const send = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
    const show = (state: string, text: string) => {
      status.dataset.state = state;
      status.textContent = text;
    };
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      send.disabled = true;
      show('sending', 'Sending…');
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        show('success', form.dataset.success!);
      } catch {
        show('error', 'Sorry, that could not be sent. Please try again.');
      } finally {
        send.disabled = false;
      }
    });
  }
</script>
