---
// Questions and answers that open in place. Props: heading, items: [{ q, a }].
// Renders nothing until it has items, so the scaffold never shows an invented answer.
const { heading = 'Questions', items = [] } = Astro.props;
---
{items.length > 0 && (
  <section class="section">
    <div class="wrap"><div class="faq">
      <h2>{heading}</h2>
      {items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div></div>
  </section>
)}
<style>
  .faq { max-width: 48rem; }
  .faq details { border-bottom: 1px solid var(--color-border); padding-block: var(--space); }
  .faq summary { cursor: pointer; font-weight: 700; font-size: var(--step-1); }
  .faq p { margin-bottom: 0; color: var(--color-muted); }
</style>
