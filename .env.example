# Copy this file to .env and fill in only what you use.
# .env is git-ignored and never packaged. Never commit real values.

# Model access for real-model runs (Claude Code login also works without this).
ANTHROPIC_API_KEY=

# Deployment (vercel plugin, off by default)
VERCEL_TOKEN=

# Forms: where the form function forwards submissions (form plugin, off by default)
FORM_WEBHOOK_URL=
