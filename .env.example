# Copy this file to .env and fill in only what you use.
# .env is git-ignored and never packaged. Never commit real values.

# Model access for real-model runs (Claude Code login also works without this).
ANTHROPIC_API_KEY=

# Deployment (vercel plugin, off by default)
VERCEL_TOKEN=
# Optional: a team id (team_...) and the Vercel project name (defaults to the Forge project id)
VERCEL_TEAM_ID=
VERCEL_PROJECT=

# Forms: HTTPS webhook the form function forwards submissions to (form-function plugin, off by default)
FORM_WEBHOOK_URL=

# Spline: optional default scene export URL (spline plugin, off by default)
SPLINE_SCENE_URL=
