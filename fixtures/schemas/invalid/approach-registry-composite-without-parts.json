{
  "id": "APP-07",
  "name": "AI + 3D + Motion + Real Website",
  "registryVersion": "0.1.0",
  "verification": "not-started",
  "summary": "Pinned sections, scroll-scrubbed reveals and section transitions with synced smooth scroll.",
  "module": {
    "skill": "skills/app07/SKILL.md",
    "recipes": []
  },
  "selectWhen": {
    "all": [
      {
        "field": "projectType",
        "op": "eq",
        "value": "flagship"
      },
      {
        "field": "tier",
        "op": "eq",
        "value": "L"
      }
    ]
  },
  "rejectWhen": {
    "field": "constraints.deviceFloor",
    "op": "eq",
    "value": "low"
  },
  "fallback": {
    "approach": "APP-02",
    "description": "Drop to APP-01 plus APP-02",
    "triggers": [
      "no-webgl",
      "low-end-device"
    ]
  },
  "budget": {
    "extraJsKbGzip": 60,
    "cls": 0.1
  },
  "dependencies": [
    {
      "name": "gsap",
      "licence": "GSAP standard licence",
      "licenceVerified": false,
      "note": "Verify terms before release"
    },
    {
      "name": "lenis",
      "licence": "MIT",
      "licenceVerified": true
    }
  ],
  "tests": {
    "positiveBriefs": [
      "tests/decision/app02/pos-1.json",
      "tests/decision/app02/pos-2.json",
      "tests/decision/app02/pos-3.json"
    ],
    "negativeBriefs": [
      "tests/decision/app02/neg-1.json",
      "tests/decision/app02/neg-2.json",
      "tests/decision/app02/neg-3.json"
    ]
  }
}
