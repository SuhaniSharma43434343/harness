{
  "id": "vercel",
  "category": "deploy",
  "version": "0.1.0",
  "enabledByDefault": false,
  "env": [
    {
      "name": "VERCEL_TOKEN",
      "required": true,
      "secret": true
    }
  ],
  "permissions": {
    "network": [
      "api.vercel.com"
    ],
    "filesystem": "project-read",
    "actions": [
      "read",
      "deploy"
    ]
  },
  "cost": {
    "paid": false
  },
  "docs": "docs/plugins.md#vercel",
  "status": "planned"
}
