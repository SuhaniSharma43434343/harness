{
  "schemaVersion": "0.1.0",
  "source": "dir-craft",
  "mode": "dark",
  "color": {
    "bg": "#14110f",
    "fg": "#f3ede6",
    "primary": "#e8a15c",
    "accent": "#7cc4b2",
    "muted": "#b9b0a6",
    "surface": "#1d1a17",
    "border": "#3d3833",
    "onPrimary": "#14110f",
    "onAccent": "#14110f",
    "link": "#e8a15c"
  },
  "font": {
    "display": {
      "family": "Fraunces",
      "stack": "\"Fraunces\", Georgia, serif",
      "weights": [
        700
      ],
      "package": "@fontsource/fraunces"
    },
    "body": {
      "family": "Inter",
      "stack": "\"Inter\", system-ui, sans-serif",
      "weights": [
        400,
        700
      ],
      "package": "@fontsource/inter"
    }
  },
  "type": {
    "base": 1.125,
    "scaleRatio": 1.25,
    "lineHeight": 1.6,
    "measure": "68ch"
  },
  "space": "1rem",
  "radius": "0.5rem",
  "motion": {
    "intensity": 1
