{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forge/tokens.schema.json",
  "title": "Design tokens (design/tokens.json, copied to site/src/styles/tokens.json)",
  "description": "The tokens the starter site is styled from. Written from the chosen design direction after B2; the site turns them into CSS custom properties. Changing them after B2 needs a new approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "mode", "color", "font", "type", "radius", "motion"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/definitions/semver" },
    "source": {
      "type": "string",
      "pattern": "^(starter-default|dir-[a-z0-9][a-z0-9-]*)$",
      "description": "starter-default, or the id of the design direction the tokens came from."
    },
    "mode": { "type": "string", "enum": ["light", "dark"] },
    "color": {
      "type": "object",
      "required": ["bg", "fg", "primary", "accent", "muted", "surface", "border", "onPrimary", "onAccent", "link"],
      "additionalProperties": { "$ref": "#/definitions/hex" },
      "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]*$" }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display", "body"],
      "properties": {
        "display": { "$ref": "#/definitions/font" },
        "body": { "$ref": "#/definitions/font" }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "scaleRatio", "lineHeight"],
      "properties": {
        "base": { "type": "number", "minimum": 1, "maximum": 1.5, "description": "Body size in rem." },
        "scaleRatio": { "type": "number", "minimum": 1.067, "maximum": 1.618 },
        "lineHeight": { "type": "number", "minimum": 1.3, "maximum": 2 },
        "measure": { "type": "string", "pattern": "^\\d+ch$" }
      }
    },
    "space": { "$ref": "#/definitions/length" },
    "radius": { "$ref": "#/definitions/length" },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intensity"],
      "properties": { "intensity": { "$ref": "common.schema.json#/definitions/motionIntensity" } }
    }
  },
  "definitions": {
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "length": { "type": "string", "pattern": "^(0|\\d+(\\.\\d+)?(rem|px))$" },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "stack"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "stack": { "type": "string", "minLength": 1, "description": "The CSS font-family value, ending in a generic family." },
        "weights": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100 } },
        "package": { "type": "string", "pattern": "^@fontsource(-variable)?/[a-z0-9-]+$", "description": "Set for Fontsource fonts; the site imports it from src/styles/fonts.css." }
      }
    }
  }
}
