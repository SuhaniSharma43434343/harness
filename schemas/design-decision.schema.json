{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forge/design-decision.schema.json",
  "title": "Design decision (design/directions.json)",
  "description": "The creative directions offered at P4 and, after B2, the chosen one. At least three distinct directions, each with its type, colour and motion choices and the contrast checks behind them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "schemaVersion", "status", "directions"],
  "properties": {
    "project": { "$ref": "common.schema.json#/definitions/projectId" },
    "schemaVersion": { "$ref": "common.schema.json#/definitions/semver" },
    "status": { "type": "string", "enum": ["proposed", "chosen"] },
    "directions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "$ref": "#/definitions/direction" }
    },
    "chosen": { "type": "string", "pattern": "^dir-[a-z0-9][a-z0-9-]*$" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "ledgerSeq"],
      "properties": {
        "code": { "const": "B2" },
        "ledgerSeq": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "chosen" } } },
      "then": { "required": ["chosen", "approval"] },
      "else": { "not": { "anyOf": [{ "required": ["chosen"] }, { "required": ["approval"] }] } }
    }
  ],
  "definitions": {
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "category", "source", "licence"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "enum": ["serif", "sans", "mono", "display", "slab", "script"] },
        "source": { "type": "string", "enum": ["fontsource", "self-hosted", "system", "client-supplied"] },
        "licence": {
          "type": "string",
          "enum": ["OFL-1.1", "Apache-2.0", "MIT", "system", "client-licensed"],
          "description": "Anything else needs B4 and is not allowed here until it has a licence record."
        },
        "weights": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100 } }
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "rationale", "typography", "colour", "motionIntensity", "layout", "renders"],
      "properties": {
        "id": { "type": "string", "pattern": "^dir-[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 2 },
        "rationale": { "type": "string", "minLength": 10, "description": "Ties the direction back to the brief's goals and tone." },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display", "body", "scaleRatio"],
          "properties": {
            "display": { "$ref": "#/definitions/font" },
            "body": { "$ref": "#/definitions/font" },
            "scaleRatio": { "type": "number", "minimum": 1.067, "maximum": 1.618 }
          }
        },
        "colour": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "tokens", "contrast"],
          "properties": {
            "mode": { "type": "string", "enum": ["light", "dark", "both"] },
            "tokens": {
              "type": "object",
              "required": ["bg", "fg", "primary", "accent", "muted"],
              "additionalProperties": { "$ref": "#/definitions/hex" },
              "properties": {
                "bg": { "$ref": "#/definitions/hex" },
                "fg": { "$ref": "#/definitions/hex" },
                "primary": { "$ref": "#/definitions/hex" },
                "accent": { "$ref": "#/definitions/hex" },
                "muted": { "$ref": "#/definitions/hex" }
              }
            },
            "contrast": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fg", "bg", "ratio", "use"],
                "properties": {
                  "fg": { "type": "string" },
                  "bg": { "type": "string" },
                  "ratio": { "type": "number", "minimum": 1, "maximum": 21 },
                  "use": { "type": "string", "enum": ["body", "large-text", "ui"] }
                },
                "allOf": [
                  {
                    "if": { "properties": { "use": { "const": "body" } } },
                    "then": { "properties": { "ratio": { "minimum": 4.5 } } },
                    "else": { "properties": { "ratio": { "minimum": 3 } } }
                  }
                ]
              }
            }
          }
        },
        "motionIntensity": { "$ref": "common.schema.json#/definitions/motionIntensity" },
        "layout": { "type": "string", "enum": ["editorial", "grid", "split", "immersive", "minimal", "modular"] },
        "approaches": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/definitions/approachId" }
        },
        "renders": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desktop", "mobile"],
          "properties": {
            "desktop": { "$ref": "common.schema.json#/definitions/relativePath" },
            "mobile": { "$ref": "common.schema.json#/definitions/relativePath" }
          }
        }
      }
    }
  }
}
