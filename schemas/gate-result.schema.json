{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forge/gate-result.schema.json",
  "title": "Gate result (gate-result.json)",
  "description": "Output of runGate(name, siteDir). A gate decides completion; an agent's own report never does.",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate", "gateVersion", "status", "startedAt", "finishedAt", "findings", "evidence"],
  "properties": {
    "gate": {
      "type": "string",
      "enum": [
        "content-parity",
        "claims",
        "accessibility",
        "performance",
        "routes",
        "forms",
        "responsive",
        "seo",
        "licences",
        "secrets",
        "dependencies"
      ]
    },
    "gateVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "project": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "error", "skipped"],
      "description": "error means the gate could not run (for example a missing tool); it is never treated as pass."
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "thresholds": { "type": "object", "additionalProperties": { "type": ["number", "string", "boolean"] } },
    "metrics": { "type": "object", "additionalProperties": { "type": ["number", "string", "boolean", "null"] } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "message"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "serious", "moderate", "minor", "info"] },
          "message": { "type": "string" },
          "location": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "error" } } },
      "then": { "required": ["error"] }
    },
    {
      "if": { "properties": { "status": { "const": "skipped" } } },
      "then": { "required": ["error"] }
    }
  ]
}
