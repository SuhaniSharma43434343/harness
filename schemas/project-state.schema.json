{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forge/project-state.schema.json",
  "title": "Project state (workspace/<project>/project.json)",
  "description": "Runtime-owned snapshot of a project's phase and the versions it was planned with. The ledger is the record of what happened; the phase and repair count can be rebuilt from it. Gate results carry only their own gateVersion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "phase", "repairLoops", "createdAt", "updatedAt", "harnessVersion"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "phase": {
      "type": "string",
      "enum": [
        "CREATED",
        "INTAKE",
        "RESEARCH",
        "APPROACH_SELECTION",
        "CREATIVE_DIRECTIONS",
        "UX_DESIGN_SYSTEM",
        "CONTENT",
        "ASSETS_LICENSING",
        "TECHNICAL_PLAN",
        "BUILD",
        "INTEGRATION_TESTS",
        "QUALITY_REVIEW",
        "REPAIR",
        "PREVIEW_REPORT",
        "PRODUCTION_DEPLOY",
        "HANDOFF"
      ]
    },
    "repairLoops": { "type": "integer", "minimum": 0, "maximum": 3 },
    "brief": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "harnessVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "registryVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Approach registry version the project was planned with. Set at intake."
    },
    "questionBankVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Question bank version intake used. Set at intake."
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version of the project-side schemas (brief, facts) the project's files follow."
    }
  }
}
